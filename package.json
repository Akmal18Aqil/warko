{
  "name": "wakro-digital",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @wakro/web --filter @wakro/api dev",
    "build": "pnpm --filter @wakro/web build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "deploy": "pnpm --filter @wakro/api run deploy"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8"
  }
}
