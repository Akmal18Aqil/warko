# Copy to `.env.local` for development.
# local  = demo mode: data lives in this browser's IndexedDB only (no server).
# remote = data from the API Worker + D1 (run `pnpm dev` at the repo root; Vite proxies /api to wrangler on :8787).
VITE_DATA_SOURCE=local

# API base path. Keep /api unless the API is hosted on another origin.
VITE_API_URL=/api
