/**
 * WAKRO Digital POS — one Worker serves the Vite SPA (static assets) and /api/* (D1).
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Database identifiers and secrets are not committed in this file.
 * After setup, replace BOOTSTRAP_SECRET with a value shorter than 32 characters to disable bootstrap.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kasa-pos",
	"main": "worker/index.ts",
	"build": {
		"command": "pnpm run build:cf"
	},
	"compatibility_date": "2026-11-16",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		}
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// The Worker only runs first for the API; every other path is served from
		// static assets, falling back to index.html so client-side routes work.
		"run_worker_first": [
			"/api/*"
		],
		"not_found_handling": "single-page-application"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kasa-pos",
			"migrations_dir": "migrations",
			"database_id": "df9b905b-761d-4b0c-9c17-5cffd8cbee0a"
		}
	],
	"secrets": {
		"required": [
			"SESSION_SECRET",
			"BOOTSTRAP_SECRET"
		]
	}
}